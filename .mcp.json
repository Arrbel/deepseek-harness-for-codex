{
  "mcpServers": {
    "deepseek-harness": {
      "command": "node",
      "args": [
        "./dist/bin.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "DEEPSEEK_API_KEY",
        "DEEPSEEK_BASE_URL",
        "DSH_MCP_DATA_DIR",
        "DSH_MCP_HARNESS_PACKAGE",
        "DSH_MCP_INSTALL_TIMEOUT_MS",
        "DSH_MCP_NPM_CLI",
        "DSH_MCP_PRUNE_VERSIONS",
        "DSH_MCP_STARTUP_TIMEOUT_MS",
        "DSH_MCP_WORKSPACE_ROOTS",
        "DSH_PERMISSION_MODE",
        "DSH_TELEMETRY_DISABLED"
      ]
    }
  }
}
