{
  "name": "deepseek-harness-for-codex",
  "version": "0.4.0",
  "description": "Codex plugin for delegating work to visible local DeepSeek Harness sessions and independently reviewing the results.",
  "type": "module",
  "bin": {
    "deepseek-harness-for-codex": "dist/bin.mjs"
  },
  "files": [
    "dist/",
    ".codex-plugin/",
    ".mcp.json",
    "skills/",
    "README.md",
    "README.en.md",
    "assets/",
    "imgs/",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arrbel/deepseek-harness-for-codex.git"
  },
  "homepage": "https://github.com/Arrbel/deepseek-harness-for-codex#readme",
  "bugs": {
    "url": "https://github.com/Arrbel/deepseek-harness-for-codex/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "build": "tsdown && node scripts/version-sync.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "version:sync": "node scripts/version-sync.mjs",
    "version:check": "node scripts/version-sync.mjs --check",
    "check-metadata": "node scripts/check-metadata.mjs",
    "check": "npm run typecheck && npm run test && npm run check-metadata && npm run build && node scripts/check-metadata.mjs --self-contained",
    "check:live": "node scripts/check-live-guard.mjs && vitest run tests/e2e/live.test.ts --reporter=verbose",
    "dsh:try": "node scripts/dsh-try.mjs",
    "sbom": "node scripts/sbom.mjs",
    "prepare:plugin": "npm run version:sync && npm run check",
    "prepack": "npm run check",
    "release:check": "npm run check && npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "codex",
    "deepseek",
    "mcp",
    "model-context-protocol",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "22.20.0",
    "@vitest/coverage-v8": "4.1.10",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
